<Page x:Class="ToursApp.Страница_2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Обращения граждан" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DGridU" Grid.Row="0" Grid.Column="0" 
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="0,90,10,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id_Обращения}" Width="60"/>
                <DataGridTextColumn Header="Текст" Binding="{Binding Текст}" Width="200"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Дата_создания, StringFormat='dd.MM.yyyy'}" Width="90"/>
                <DataGridTextColumn Header="ID жителя" Binding="{Binding id_Жителя}" Width="70"/>
                <DataGridTextColumn Header="ID сотрудника" Binding="{Binding id_Сотрудника}" Width="80"/>
                <DataGridTextColumn Header="ID статуса" Binding="{Binding id_Статуса}" Width="70"/>
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Ред" Click="BtnEdit_Click" Width="50" Height="25"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0" Grid.Column="1" Width="220" Margin="0,70,0,10">
            <Border Padding="10" CornerRadius="8" >
                <StackPanel>
                    <TextBlock Text="Поиск и фильтры" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>


                    <TextBox Name="txtSearch" Height="30" ToolTip="Поиск по тексту" Margin="0,0,0,10"/>
                    <Button Name="btnSearch" Content="Поиск" Height="30" Margin="0,0,0,10" 
                            Click="btnSearch_Click" Background="#008000" Foreground="White"/>

                    <TextBlock Text="Статус:" Margin="0,5,0,5"/>
                    <ComboBox Name="cbStatus" Height="30" Margin="0,0,0,10"
                              DisplayMemberPath="Название" SelectedValuePath="id_Статуса"
                              SelectionChanged="cbFilter_SelectionChanged"/>
                    <TextBlock Text="Дата от:" Margin="0,5,0,5"/>
                    <DatePicker Name="dpDateFrom" Height="30" Margin="0,0,0,10"
                                SelectedDateChanged="cbFilter_SelectionChanged"/>
                    <TextBlock Text="Дата до:" Margin="0,5,0,5"/>
                    <DatePicker Name="dpDateTo" Height="30" Margin="0,0,0,10"
                                SelectedDateChanged="cbFilter_SelectionChanged"/>
                    <TextBlock Text="Сотрудник:" Margin="0,5,0,5"/>
                    <ComboBox Name="cbEmployee" Height="30" Margin="0,0,0,10"
                              DisplayMemberPath="ФИО" SelectedValuePath="id_Сотрудника"
                              SelectionChanged="cbFilter_SelectionChanged"/>
                    <Button Name="btnReset" Content="Сбросить" Height="30" Margin="0,10,0,0" 
                            Click="btnReset_Click" Background="#808080" Foreground="White"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,0,0,0">
            <Button Content="Добавить" Name="BtnAdd" Click="BtnAdd_Click" Width="100" Height="30" Margin="5"/>
            <Button Content="Удалить" Name="BtnDelete" Click="BtnDelete_Click" Width="100" Height="30" Margin="5"/>
            <Button Content="Статистика" Name="BtnStatistics" Click="BtnStatistics_Click" 
            Width="120" Height="30" Margin="5" Grid.Column="3" Background="#008000" Foreground="White"/>
            <Button Content="Справочная информация" Name="BtnInfo" Click="BtnInfo_Click" 
            Width="232" Height="30" Margin="5" Grid.Column="4" />
        </StackPanel>
    </Grid>
</Page>