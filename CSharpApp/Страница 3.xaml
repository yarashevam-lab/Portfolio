<Page x:Class="ToursApp.Страница_3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ToursApp"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Страница_3">

    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150*"/>
            <ColumnDefinition Width="550"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="117*"/>
            <RowDefinition Height="111*"/>
            <RowDefinition Height="96*"/>
            <RowDefinition Height="95*"/>
            <RowDefinition Height="71*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ID обращения" VerticalAlignment="Top" Margin="0,85,0,0" Height="16" Width="78"/>
        <TextBlock Text="Текст обращения" Grid.Row="1" VerticalAlignment="Top" Margin="0,50,0,0" Height="16" Width="96"/>
        <TextBlock Text="Сотрудник" Grid.Row="3" Height="15" Width="58" Margin="0,47,0,0" VerticalAlignment="Top"/>
        <TextBlock Text="Образовательные учреждения:" Grid.Row="2"  Height="18" Width="214" HorizontalAlignment="Left" Margin="32,0,0,0"/>
        
        <TextBox x:Name="TxtID" Grid.Column="1" Height="30" Margin="201,76,175,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TxtName" Grid.Column="1" Grid.Row="1" Height="70" TextWrapping="Wrap" VerticalAlignment="Top" Margin="88,22,87,0"/>

        <ComboBox x:Name="CmbСотрудники" Grid.Column="1" Grid.Row="3" Height="30" 
                  DisplayMemberPath="ФИО" SelectedValuePath="id_Сотрудника" Margin="185,0,165,0"/>
        <ComboBox x:Name="CmbОбразовательные_учреждения" Grid.Row="2" Grid.Column="1" 
          Width="300" Height="35" Margin="127,33,0,0"
          DisplayMemberPath="Название" 
          SelectedValuePath="id_Образовательного_учреждения"
          HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Content="Сохранить" Grid.Row="4" Name="BtnSave" Click="BtnSave_Click" Width="NaN" Height="NaN" Margin="213,10,187,14" Grid.Column="1"/>
    </Grid>
</Page>